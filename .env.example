# OHANDS client settings. AIGW's enterprise connector configuration stays in AIGW.
LLM_BASE_URL=http://localhost:3100/v1
LLM_MODEL=openai/gemini-2.5-pro
LLM_API_KEY=aigw-local
LLM_TIMEOUT=300
LLM_MAX_OUTPUT_TOKENS=8192

# Workspace defaults to the directory containing ohands.py. Set your target project.
# AIGW_WORKSPACE=C:\GitHub\shaybc\your-project
AIGW_MAX_ITERATIONS=100

# Keep enclosing quotes to preserve line breaks.
OHANDS_PROMPT="Review this project for bugs and explain your findings with file references.

Do not change any files unless I explicitly request changes in this prompt."
