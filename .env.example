# Copy to .env and replace connector values. Values are stored in clear text.

# the AIGW host and port, model to use ...
HOST=localhost
PORT=7331
GEMINI_CONNECTOR_MODEL=gemini-2.5-pro
LLM_API_KEY=dummy

LLM_TIMEOUT=300
LLM_MAX_OUTPUT_TOKENS=8192
AIGW_MAX_ITERATIONS=100

# set the project source root
AIGW_WORKSPACE=C:\Workspace\test

# Keep enclosing quotes to preserve multiline text.
OHANDS_PROMPT="Review this project and explain what does it do.

Do not change any files."
